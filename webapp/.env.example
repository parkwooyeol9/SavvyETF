# Copied to Vercel project env (and optionally .env.local for local ingest tests)
WEB_INGEST_SECRET=generate_a_long_random_string

# Preferred durable store: Cloudflare R2 (Hobby Blob replacement)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=savvyetf-briefs
# Optional public CDN base (r2.dev or custom domain, no trailing slash):
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# Or force media proxy base (defaults to this Vercel deployment):
# BRIEF_MEDIA_BASE_URL=https://savvyetf.vercel.app/api/briefs/media

# Legacy optional — only if you still keep a Vercel Blob store:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional — 천만원 챌린지 (업비트엔진 + 바이낸스엔진)
# Vercel: public APIs only. Render: UPBIT_* + BINANCE_* keys in repo root .env
# See root .env.example for CHALLENGE_* / KIMCHI_ARB_* variables

# Economy / Macro Risk Monitor tab (시황 → 경제)
# Same keys as the Render bot /macro pipeline — optional but recommended:
# FRED_API_KEY=your_fred_api_key
# FINNHUB_API_KEY=your_finnhub_api_key
# Optional for AI 거버넌스 local fallback screen (bot path preferred):
# DART_API_KEY=your_dart_api_key
# SEC_CONTACT_EMAIL=your@email.com
# SEC_EDGAR_USER_AGENT=SavvyETF/1.0 (your@email.com)
