TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Public launch: channels stay open for anyone to join/read.
# allowlist only gates heavy bot DM commands (/dart, /comp, /etf_holdings, …).
# Light commands (/help, /etf, /etfcheck, …) stay open.
# Empty allowlists with ACCESS_MODE=allowlist deny heavy commands (fail closed).
# TELEGRAM_ACCESS_MODE=allowlist
# TELEGRAM_ALLOWED_USER_IDS=111111111,222222222
# TELEGRAM_ALLOWED_CHAT_IDS=   # optional; not needed for public channel readers
# TELEGRAM_HEAVY_COOLDOWN_SECONDS=45
# Optional: protect /health and Kakao admin routes
# HEALTH_CHECK_SECRET=long_random_string
# BOT_ADMIN_SECRET=long_random_string
# Required for bot /api/web/* and GET /api/web-briefs. Same value on Vercel.
# WEB_INGEST_SECRET is accepted as a fallback if this is unset.
# BOT_WEB_API_SECRET=long_random_string
# Optional legacy ETF channel (scheduled /etfcheck, /etf_sector):
# TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# US scheduled briefs (/summary, /summary_pre, /reddit):
# TELEGRAM_CHAT_ID_US=-100xxxxxxxxxx
# Korea / NXT scheduled briefs (/summary_kor*, /summary_nxt):
# TELEGRAM_CHAT_ID_KOR=-100xxxxxxxxxx
# SavvyESG channel (/esg monitor|accident|overview schedules):
# TELEGRAM_CHAT_ID_ESG=-100xxxxxxxxxx
# Public base URL for summary page (set after deploy)
# SUMMARY_PUBLIC_URL=https://your-app.onrender.com
# Optional separate Korea brief URL (defaults to same host + /summary_kor)
# SUMMARY_KOR_PUBLIC_URL=https://your-app.onrender.com/summary_kor
# KST fixed-time US brief (supports HH:MM, e.g. 7:00)
# SUMMARY_SCHEDULE_HOURS_KST=7:00
# SUMMARY_SCHEDULE_ENABLED=true
# Premarket brief (/summary_pre) before US open — default OFF (US evening: /reddit only)
# SUMMARY_PRE_SCHEDULE_ENABLED=false
# SUMMARY_PRE_SCHEDULE_KST=21:50
# SUMMARY_PRE_CATCHUP_MINUTES=60
# Daily /reddit broadcast at 21:00 KST (17/19 disabled)
# REDDIT_SCHEDULE_ENABLED=true
# REDDIT_SCHEDULE_HOURS_KST=21
# REDDIT_SCHEDULE_POLL_SECONDS=60
# Korea intraday brief (default OFF — use /summary_kor_intra manually)
# SUMMARY_KOR_INTRA_SCHEDULE_ENABLED=false
# SUMMARY_KOR_INTRA_SCHEDULE_HOURS_KST=11
# Korea EOD brief weekdays at 15:40 KST
# SUMMARY_KOR_SCHEDULE_ENABLED=true
# SUMMARY_KOR_SCHEDULE_KST=15:40
# NXT post-close only by default (add 8:30 if wanted: 8:30,16:40)
# SUMMARY_NXT_SCHEDULE_ENABLED=true
# SUMMARY_NXT_SCHEDULE_KST=16:40
# Legacy ETF channel: /etfcheck ON; /etf_kor15 · /etf_sector · /etf_us_new OFF by default
# ETF_SECTOR_SCHEDULE_ENABLED=false
# ETF_SECTOR_SCHEDULE_KST=7:05
# ETF_US_NEW_SCHEDULE_ENABLED=false
# ETF_US_NEW_SCHEDULE_KST=7:20
# ETF_US_NEW_MAX_PROBES=400
# ETFCHECK_SCHEDULE_ENABLED=true
# ETFCHECK_SCHEDULE_KST=15:45
# Optional override if site Checkclient key rotates (client also refreshes from /js/build.js)
# ETFCHECK_CHECK_KEY=
# Korea-exposure US ETF basket (/etf_kor15) — default OFF (수동 /etf_kor15)
# ETF_KOR15_SCHEDULE_ENABLED=false
# ETF_KOR15_SCHEDULE_KST=9:10
# ETF_KOR15_CATCHUP_MINUTES=180
# Korean ETF DB daily snapshot (AUM/flow history for /etfdb) — no Telegram
# Mirrors to R2: etf_db/latest.json + etf_db/snapshots/{date}.json
# ETFDB_SCHEDULE_ENABLED=true
# ETFDB_SCHEDULE_KST=16:05
# CREDIT_MONITOR_SCHEDULE_ENABLED=true
# CREDIT_MONITOR_SCHEDULE_KST=09:35
# CREDIT_MONITOR_CATCHUP_MINUTES=180
# FreeSIS/신용 → R2 credit_monitor/latest.json (Vercel reads cache)
# ETF weight monitor — Roundhill ALL (Filepoint) + iShares Yahoo-AUM top N
# ETF_WEIGHT_SCHEDULE_ENABLED=true
# ETF_WEIGHT_SCHEDULE_KST=07:30
# KOSDAQ Active ETF compare (6 funds) — post-close PDF snapshots
# KOSDAQ_ACTIVE_SCHEDULE_ENABLED=true
# KOSDAQ_ACTIVE_SCHEDULE_KST=15:55
# KOSDAQ_ACTIVE_CATCHUP_MINUTES=180
# KOSDAQ 100 monitor — post-close snapshot + AI briefing
# KOSDAQ100_SCHEDULE_ENABLED=true
# KOSDAQ100_SCHEDULE_KST=15:50
# KOSDAQ100_CATCHUP_MINUTES=180
# ETF_WEIGHT_ISHARES_TOP_N=15
# ETF_WEIGHT_CATCHUP_MINUTES=60
# SavvyESG: /esg events 09:00 daily + /esg accident (중대재해) by default
# ESG_SCHEDULE_ENABLED=true
# ESG_EVENTS_SCHEDULE_ENABLED=true
# ESG_EVENTS_SCHEDULE_KST=9:00
# ESG_MONITOR_SCHEDULE_ENABLED=false
# ESG_MONITOR_SCHEDULE_KST=9:05
# ESG_ACCIDENT_SCHEDULE_ENABLED=true
# ESG_ACCIDENT_SCHEDULE_KST=9:30
# ESG_OVERVIEW_SCHEDULE_ENABLED=false
# ESG_OVERVIEW_SCHEDULE_KST=9:45
# ESG_AIGOV_SCHEDULE_ENABLED=false
# ESG_AIGOV_SCHEDULE_KST=10:00
# ESG_AIBRIEF_SCHEDULE_ENABLED=false
# ESG_AIBRIEF_SCHEDULE_KST=10:15
# ESG_SCHEDULE_OVERVIEW_QUERIES=삼성전자,SK하이닉스
# ESG·지정학 data briefing (default OFF)
# ESG_BRIEF_SCHEDULE_ENABLED=false
# ESG_BRIEF_SCHEDULE_KST=11:00
# WEBAPP_PUBLIC_URL=https://savvyetf.vercel.app
# Vercel 4-tab dashboard publish (see webapp/README.md)
# WEB_PUBLISH_URL=https://savvyetf.vercel.app/api/ingest
# WEB_INGEST_SECRET=generate_a_long_random_string
# Community board (Vercel webapp) — Supabase Auth Google + Postgres
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # optional, admin moderation
# COMMUNITY_ADMIN_EMAILS=you@gmail.com
# Card news board (Vercel) — upload password. Falls back to COMMUNITY_ADMIN_SECRET.
# CARDNEWS_ADMIN_SECRET=generate_a_long_random_string
# COMMUNITY_ADMIN_SECRET=generate_a_long_random_string
# Cloudflare R2 — durable briefs store (preferred over Vercel Blob Hobby)
# Same R2_* values on Render bot + Vercel webapp
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=savvyetf-briefs
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# BRIEF_MEDIA_BASE_URL=https://savvyetf.vercel.app/api/briefs/media

# --- 천만원 챌린지: 업비트엔진 (Render bot) ---
# Vercel cron :15 → upbit_paper/signals_latest.json
# UPBIT_ACCESS_KEY=your_upbit_access_key
# UPBIT_SECRET_KEY=your_upbit_secret_key
# UPBIT_LIVE=false
# UPBIT_KILL_SWITCH=false
# UPBIT_MAX_DAILY_LOSS_PCT=5
# UPBIT_MAX_POSITION_PCT=40
# UPBIT_MIN_KRW_RESERVE=100000
# UPBIT_ORDER_COOLDOWN_SECONDS=3600
# UPBIT_TRADING_SCHEDULE_ENABLED=true
# UPBIT_TRADING_POLL_SECONDS=300

# --- 천만원 챌린지: 바이낸스엔진 (Render bot) ---
# Vercel cron :20 → binance_paper/signals_latest.json + challenge/kimchi_arb_latest.json
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_SECRET_KEY=your_binance_secret_key
# Render(US) → Binance fapi HTTP 451 시 허용국 HTTPS 프록시 필요
# BINANCE_HTTPS_PROXY=http://user:pass@proxy-host:port
# BINANCE_FAPI_BASE=https://fapi.binance.com
# BINANCE_LIVE=false
# BINANCE_KILL_SWITCH=false
# BINANCE_MAX_DAILY_LOSS_PCT=5
# BINANCE_MAX_POSITION_PCT=40
# BINANCE_MIN_USDT_RESERVE=50
# BINANCE_ORDER_COOLDOWN_SECONDS=3600

# --- 김프 차익 (양 엔진 동시 — KIMCHI_ARB_LIVE=true 시) ---
# 숏김프는 업비트 BTC 잔고 필수. 없으면 전체 skip (바이낸스 단독 롱 금지).
# KIMCHI_ARB_LIVE=false
# KIMCHI_ARB_KILL_SWITCH=false
# KIMCHI_ARB_MAX_USDT=500
# KIMCHI_ARB_MAX_KRW=700000
# KIMCHI_ARB_ENTER_PCT=3.0
# KIMCHI_ARB_EXIT_PCT=0.5
# KIMCHI_ARB_STEADY_PCT=1.2
# KIMCHI_ARB_MAX_HOLD_DAYS=14
# KIMCHI_ARB_MAX_ADVERSE_PCT=2.5
# --- 천만원 챌린지 통합 (양 엔진 + 김프차익 한 번에 켜기) ---
# CHALLENGE_LIVE=true → UPBIT_LIVE·BINANCE_LIVE·KIMCHI_ARB_LIVE 대신 사용 가능
# CHALLENGE_LIVE=false
# CHALLENGE_KILL_SWITCH=false
# CHALLENGE_TRADING_SCHEDULE_ENABLED=true
# CHALLENGE_TRADING_POLL_SECONDS=300
# Telegram으로 LIVE/리스크 제어 (R2 challenge/runtime_config_v1.json)
# 관리자: TELEGRAM_ALLOWED_USER_IDS 또는 아래 (둘 중 하나 필수)
# CHALLENGE_ADMIN_USER_IDS=111111111
# CHALLENGE_ADMIN_CHAT_IDS=
# 명령: /challenge_status /upbit_live confirm /upbit_off /upbit_risk
#       /binance_live /kimchi_live(/kimch_live) /challenge_kill /challenge_help
# FRED API key for /macro (free): https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key
# SEC EDGAR fair-access User-Agent (required for /macro EDGAR data)
# https://www.sec.gov/os/accessing-edgar-data
# SEC_EDGAR_USER_AGENT=SavvyETF/1.0 (your@email.com)
# or:
# SEC_CONTACT_EMAIL=your@email.com
# Finnhub — /etf_pre /sp_pre /nas_pre, /financial, /macro, /adr history merge, etc.
# https://finnhub.io/
# FINNHUB_API_KEY=your_finnhub_api_key
# FinMind (Taiwan depth for /adr TWSE underlyings): https://finmindtrade.com/
# FINMIND_TOKEN=your_finmind_token
# EODHD (global EOD for /adr history merge): https://eodhd.com/
# EODHD_API_KEY=your_eodhd_api_key
# Open DART (Korean /dart fundamentals): https://opendart.fss.or.kr/
# DART_API_KEY=your_dart_api_key
# Financial Modeling Prep (analyst estimates etc.): https://site.financialmodelingprep.com/register
# FMP_API_KEY=your_fmp_api_key
# Gemini for /aibriefing, /reddit, and /summary AI brief: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# Optional Reddit app credentials for /reddit OAuth JSON (scores/flair). Public RSS works without these.
# https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# Defer heavy scheduled jobs after boot (Render health check / avoid startup OOM)
# SCHEDULER_STARTUP_GRACE_SECONDS=180
# Defer heavy Yahoo cache warmup to background thread (saves startup RAM)
# BOT_DEFER_CACHE_WARMUP=true
# BOT_STARTUP_CACHE_UNIVERSES=etf
# BOT_DEFERRED_CACHE_UNIVERSES=sp,nas
# On Render Starter: set BOT_STARTUP_CACHE_UNIVERSES= (empty) to skip boot warmup
# Linux allocator tuning for small containers
# MALLOC_ARENA_MAX=2
# MEMORY_DEBUG=true
# SUMMARY_HEAVY_WORK_WAIT_SECONDS=600
